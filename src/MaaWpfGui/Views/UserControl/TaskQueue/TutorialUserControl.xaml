<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.TutorialUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    MaxWidth="220"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:TutorialSettingsUserControlModel}}"
    d:DesignWidth="220"
    mc:Ignorable="d">
    <StackPanel>
        <controls:TextBlock
            Margin="0,0,0,10"
            Text="{DynamicResource TutorialTaskTip}"
            TextWrapping="Wrap" />

        <!--  已写好、现在就能跑的教学段落：一段一个方框  -->
        <ItemsControl ItemsSource="{Binding ImplementedStages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,6"
                        Padding="8,6"
                        Background="{DynamicResource RegionBrushOpacity25}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Text="{Binding}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:TextBlock
            Margin="0,10,0,0"
            FontSize="12"
            Foreground="{DynamicResource TraceLogBrush}"
            Text="{DynamicResource TutorialTaskProgressTip}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
