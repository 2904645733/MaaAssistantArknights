<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.CopilotUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:CopilotSettingsUserControlModel}}"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 重命名图标（boxicons:rename）：填充型，"口"字形 + I 形光标 -->
        <PathGeometry
            x:Key="CopilotRenameGeometry"
            Figures="M20 6h-3v2h3v8h-3v2h3c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2 M4 18h9v2h-3v2h8v-2h-3V4h3V2h-8v2h3v2H4c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2 M4 8h9v8H4z"
            FillRule="Nonzero" />
        <!-- 无边框小图标按钮（与主界面任务列表动作按钮同款） -->
        <Style
            x:Key="TaskActionButtonStyle"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="hc:IconElement.Height" Value="14" />
            <Setter Property="hc:IconElement.Width" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 不画虚线焦点框：回车结束重命名后焦点会落到这些按钮上 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 运行中（!Idle）时列表里的小图标变浅：勾选框和按钮有控件自带的禁用样式，Path 没有 -->
        <Style x:Key="StepIconDimStyle" TargetType="Path">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 名字输入框：圆角浅底方块，无下划线/悬停下阴影 -->
        <Style x:Key="StepNameTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource RegionBrushOpacity25}"
                            CornerRadius="4">
                            <ScrollViewer
                                Margin="0"
                                VerticalAlignment="Center"
                                x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MouseOverRegionBrushOpacity75}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MouseOverRegionBrushOpacity75}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!--  常规设置  -->
        <StackPanel Visibility="{c:Binding '!EnableAdvancedSettings', Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <!--  战斗小任务：和下面的「导航」一样，标题 + 问号提示 + 按键  -->
            <StackPanel IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}">
                <StackPanel Margin="0,3,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource CopilotBattleTitle}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource CopilotBattlePickerTip}" />
                </StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Margin="0,0,8,0"
                        Command="{s:Action AddBattleFromPage}"
                        Content="{DynamicResource CopilotAddBattle}" />
                    <!-- 作业页里没作业可记录时，提示就近显示在按钮右边 -->
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TraceLogBrush}"
                        Text="{Binding BattleAddHint}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasBattleAddHint, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>

            <!--  导航小任务：和"自动肉鸽 · 开局干员"一样直接摆在这里（可搜索下拉框 + 添加），不用先点按钮展开  -->
            <StackPanel IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}">
                <StackPanel Margin="0,3,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource CopilotNavTitle}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource CopilotNavPickerTip}" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  搜索/过滤由界面逻辑做（NavFilteredOptions），不用 MakeComboBoxSearchable：
                          那套要自己换 ItemsSource + 设 Items.Filter，在这个框上没挂住（打字后列表不过滤）。
                          输入的文本由 code-behind 直接监听里面那个 TextBox 写回界面逻辑（不依赖 Text 绑定的默认模式）。
                          回车：只匹配到一个就直接"添加"，多个或零个就打开下拉列出结果  -->
                    <hc:ComboBox
                        x:Name="NavTargetComboBox"
                        DisplayMemberPath="Display"
                        IsEditable="True"
                        IsSynchronizedWithCurrentItem="False"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding NavFilteredOptions}"
                        Loaded="NavTargetComboBox_Loaded"
                        LostKeyboardFocus="NavTargetComboBox_LostKeyboardFocus"
                        MaxDropDownHeight="380"
                        PreviewKeyDown="NavTargetComboBox_PreviewKeyDown"
                        SelectedItem="{Binding SelectedNavOption}"
                        StaysOpenOnEdit="True"
                        Text="{Binding NavSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="56"
                        Margin="8,0,0,0"
                        Click="AddNavButton_Click"
                        Command="{s:Action AddSelectedNav}"
                        Content="{DynamicResource CopilotNavAdd}" />
                </Grid>
                <!--  主线 10~14 章有标准 / 磨难两个模式：选中这些章节后才出现。
                      样式和活动那个 EX / S 一样：不显示"难度"两个字、两个勾选框居中、可不选；
                      都不勾选 = 不切难度，点完「前往章节」这一步就结束  -->
                <StackPanel
                    Margin="0,6,0,4"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowNavDifficulty, Converter={StaticResource BoolToVis}}">
                    <CheckBox
                        Content="{DynamicResource CopilotNavDifficultyNormal}"
                        IsChecked="{Binding NavDifficultyIsNormal}" />
                    <CheckBox
                        Margin="40,0,0,0"
                        Content="{DynamicResource CopilotNavDifficultyHard}"
                        IsChecked="{Binding NavDifficultyIsHard}" />
                </StackPanel>
                <!--  活动有 EX / S 两种关卡模式（S 只有部分活动有）：选中活动后才出现；都不勾选 = 普通关。
                      这里不显示"模式"两个字，两个勾选框整体在这一行里水平居中  -->
                <StackPanel
                    Margin="0,6,0,10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowNavMode, Converter={StaticResource BoolToVis}}">
                    <CheckBox
                        Content="{DynamicResource CopilotNavModeEX}"
                        IsChecked="{Binding NavModeIsEX}"
                        Visibility="{Binding SelectedNavOption.HasEx, Converter={StaticResource BoolToVis}}" />
                    <CheckBox
                        Margin="40,0,0,0"
                        Content="{DynamicResource CopilotNavModeS}"
                        IsChecked="{Binding NavModeIsS}"
                        Visibility="{Binding SelectedNavOption.HasS, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>

            <!--  与主界面任务队列一致的拖拽行为（dd:DragDrop 不会触发选中，避免文字变色）。
                 跑任务时（Idle=false）只关掉拖拽、勾选框和行内按钮，列表本身不禁用——这样才能继续滚动查看。  -->
            <ListBox
                x:Name="StepList"
                MaxHeight="220"
                Margin="0,8,0,0"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding Items}"
                dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                dd:DragDrop.IsDragSource="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                dd:DragDrop.IsDropTarget="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                PreviewMouseWheel="List_PreviewMouseWheel"
                Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ListBox.ItemContainerStyle>
                    <Style
                        BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}"
                        TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="4,2"
                            ToolTip="{Binding Name}"
                            s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 勾选（跑完自动取消勾选）+ 标记/拖拽把手：
                                     战斗=斜向短剑；普通导航=向右箭头；
                                     剿灭导航=对/错（能不能从"后面第一个作战任务的作业"里读出剿灭关卡名） -->
                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <CheckBox
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked}"
                                        IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}" />
                                    <!--  作战任务：交叉双剑（akar-icons:double-sword）  -->
                                    <Path
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="M2 19.2L3.8 21m.9-7.2l.9 3.6m0 0l3.6.9m-3.6-.9l-2.7 2.7M16.4 3.9l-9 9l.45 2.25l2.25.45l9-9L20 3z M22 19.2L20.2 21m-.9-7.2l-.9 3.6m0 0l2.7 2.7m-2.7-2.7l-1.8.45l-1.8.45M9.3 11L4.9 6.6L4 3l3.6.9L12 8.3m.1 5.5l1.8 1.8l2.25-.45l.45-2.25l-1.8-1.8"
                                        Stroke="{DynamicResource SecondaryTextBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.3"
                                        Style="{StaticResource StepIconDimStyle}"
                                        Stretch="Uniform"
                                        ToolTip="{DynamicResource LabelSequenceTip}"
                                        Visibility="{Binding ShowBattleIcon, Converter={StaticResource BoolToVis}}" />
                                    <!--  导航：导航箭头（bx:navigation，填充型）  -->
                                    <Path
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="F1 M2.002 9.63c-.023.411.207.794.581.966l7.504 3.442l3.442 7.503c.164.356.52.583.909.583l.057-.002a1 1 0 0 0 .894-.686l5.595-17.032c.117-.358.023-.753-.243-1.02s-.66-.358-1.02-.243L2.688 8.736a1 1 0 0 0-.686.894m16.464-3.971l-4.182 12.73l-2.534-5.522a1 1 0 0 0-.492-.492L5.734 9.841z"
                                        Fill="{DynamicResource SecondaryTextBrush}"
                                        Style="{StaticResource StepIconDimStyle}"
                                        Stretch="Uniform"
                                        ToolTip="{DynamicResource LabelSequenceTip}"
                                        Visibility="{Binding ShowNavIcon, Converter={StaticResource BoolToVis}}" />
                                    <!--  剿灭导航：从下一个作战任务的作业里读到了剿灭关卡名 → 地点图钉（akar-icons:location），用勾选框那种蓝  -->
                                    <Path
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="M9,10 A3,3 0 1 0 15,10 A3,3 0 1 0 9,10z M12,2 A8,8 0 0 0 4,10 c0,1.892 0.402,3.13 1.5,4.5 L12,22 l6.5,-7.5 c1.098,-1.37 1.5,-2.608 1.5,-4.5 A8,8 0 0 0 12,2"
                                        Stroke="{DynamicResource PrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5"
                                        Style="{StaticResource StepIconDimStyle}"
                                        Stretch="Uniform"
                                        ToolTip="{Binding AnnihilationIconTip}"
                                        Visibility="{Binding ShowAnnihilationOkIcon, Converter={StaticResource BoolToVis}}" />
                                    <!--  剿灭导航：读不到剿灭关卡名 → 错位地点图钉（ic:outline-wrong-location）  -->
                                    <Path
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="F1 M18 11v.2c0 2.34-1.95 5.44-6 9.14c-4.05-3.7-6-6.79-6-9.14C6 7.57 8.65 5 12 5c.34 0 .68.03 1 .08V3.06c-.33-.04-.66-.06-1-.06c-4.2 0-8 3.22-8 8.2c0 3.32 2.67 7.25 8 11.8c5.33-4.55 8-8.48 8-11.8V11z M10,11 A2,2 0 1 0 14,11 A2,2 0 1 0 10,11z M22.54 2.88l-1.42-1.42L19 3.59l-2.12-2.13l-1.42 1.42L17.59 5l-2.13 2.12l1.42 1.42L19 6.41l2.12 2.13l1.42-1.42L20.41 5z"
                                        Fill="{DynamicResource ErrorLogBrush}"
                                        Style="{StaticResource StepIconDimStyle}"
                                        Stretch="Uniform"
                                        ToolTip="{Binding AnnihilationIconTip}"
                                        Visibility="{Binding ShowAnnihilationFailIcon, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- 运行中（!Idle）名字和小图标一起变浅 -->
                                                <DataTrigger Binding="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox
                                    Grid.Column="1"
                                    KeyDown="StepNameBox_KeyDown"
                                    LostFocus="{s:Action SaveName}"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{DynamicResource CopilotStepNameTip}">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource StepNameTextBoxStyle}" TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                                    Orientation="Horizontal">
                                    <!-- 战斗小任务：重命名 + 删除 + 高级设置；导航小任务：只有删除 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBattle, Converter={StaticResource BoolToVis}}">
                                        <Button
                                            hc:IconElement.Geometry="{StaticResource CopilotRenameGeometry}"
                                            Command="{s:Action RenameItem}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TaskActionButtonStyle}"
                                            ToolTip="{DynamicResource Rename}" />
                                        <Button
                                            Command="{s:Action OpenAdvanced}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TaskActionButtonStyle}"
                                            ToolTip="{DynamicResource CopilotAdvancedTitle}">
                                            <!-- 高级设置：bytesize:settings。这套图标是描边风格，用 Path 描边画（塞进 IconElement 会被填成一坨）；颜色跟随按钮，所以鼠标悬停也会变色 -->
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="M13 2v4l-2 1l-3-3l-4 4l3 3l-1 2H2v6h4l1 2l-3 3l4 4l3-3l2 1v4h6v-4l2-1l3 3l4-4l-3-3l1-2h4v-6h-4l-1-2l3-3l-4-4l-3 3l-2-1V2Z M12,16 A4,4 0 1 0 20,16 A4,4 0 1 0 12,16z"
                                                Stretch="Uniform"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.1" />
                                        </Button>
                                    </StackPanel>
                                    <Button
                                        hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                        Command="{s:Action DeleteItem}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TaskActionButtonStyle}"
                                        ToolTip="{DynamicResource QueueDelete}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!--  高级设置：与作业页多作业列表同款  -->
        <StackPanel Visibility="{c:Binding 'EnableAdvancedSettings', Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <TextBlock
                Margin="0,4"
                FontSize="12"
                Foreground="{DynamicResource TraceLogBrush}"
                Text="{DynamicResource CopilotAdvancedNeedTarget}"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Visibility="{Binding NoAdvancedTarget, Converter={StaticResource BoolToVis}}" />

            <StackPanel Visibility="{Binding HasAdvancedTarget, Converter={StaticResource BoolToVis}}">
                <!-- 对应小任务的名字（随重命名同步，无边框，居中） -->
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="14"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{Binding AdvancedOwnerName}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <!-- 编辑 / 更新 / 清除（作用于上方小任务） -->
                <StackPanel
                    Margin="0,6,0,6"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="64"
                        Command="{s:Action EditItem}"
                        CommandParameter="{Binding AdvancedOwner}"
                        Content="{DynamicResource CopilotStepEdit}" />
                    <Button
                        MinWidth="64"
                        Margin="8,0,0,0"
                        Command="{s:Action SaveItem}"
                        CommandParameter="{Binding AdvancedOwner}"
                        Content="{DynamicResource CopilotStepSave}" />
                    <Button
                        MinWidth="64"
                        Margin="8,0,0,0"
                        Command="{s:Action ClearItemJobs}"
                        CommandParameter="{Binding AdvancedOwner}"
                        Content="{DynamicResource CopilotClearJobs}" />
                </StackPanel>

                <!--  章末剧情：只有作战小任务有；勾上后这一步的作业全打完了，会往章节末尾滑地图找剧情关并播完  -->
                <StackPanel
                    Margin="0,2,0,4"
                    IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    Orientation="Horizontal"
                    Visibility="{Binding AdvancedOwner.IsBattle, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="{DynamicResource CopilotEndPlot}" IsChecked="{Binding AdvancedOwner.Model.EndPlot}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource CopilotEndPlotTip}" />
                    <hc:NumericUpDown
                        Height="20"
                        Margin="6,0,0,0"
                        InputMethod.IsInputMethodEnabled="False"
                        Maximum="9999"
                        Minimum="1"
                        Value="{Binding AdvancedOwner.Model.EndPlotTimes}" />
                </StackPanel>

                <ListBox
                    x:Name="AdvancedList"
                    MaxHeight="260"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{Binding Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding AdvancedItems}"
                    dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    PreviewMouseWheel="List_PreviewMouseWheel"
                    BorderThickness="1"
                    Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                    ToolTip="{DynamicResource LabelSequenceTip}"
                    s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}" TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRaid}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Copilot.RaidBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" />
                                </CheckBox>
                                <Button
                                    Grid.Column="1"
                                    Margin="0"
                                    Padding="5,6"
                                    hc:IconElement.Geometry="{StaticResource CopilotListItemToParse}"
                                    hc:VisualElement.HighlightBackground="Transparent"
                                    hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{s:Action LoadJobToPage}"
                                    CommandParameter="{Binding}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    ToolTip="{DynamicResource CopilotSelectTaskTip}" />
                                <Button
                                    Grid.Column="2"
                                    Margin="0"
                                    Padding="5,0,10,0"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    hc:VisualElement.HighlightBackground="Transparent"
                                    hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{s:Action RemoveAdvancedJob}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
