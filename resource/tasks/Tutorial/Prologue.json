    "Tutorial@Prologue@Begin": {
        "Doc": "新手教程·序章（上/下）：教学关进关由游戏自己完成，既没有「开始行动」也没有结算，所以全程由这里驱动。从任意进度接手都可以 —— 每轮都在看画面，遇到需要动手的那句才动手",
        "algorithm": "JustReturn",
        "next": ["Tutorial@Prologue@Loop"]
    },

    "Tutorial@Prologue@Loop": {
        "Doc": "轮询：①教学要求的动作（6 处，上下文字框各一个变体）②跳过剧情 ③认到头像图案就点一下对话 ④认不到就什么都不做（不瞎点）",
        "algorithm": "JustReturn",
        "next": [
