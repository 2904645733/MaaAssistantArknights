    "Tutorial@Gacha@Skip": {
        "Doc": "抽卡的「跳过」：教学这次抽卡没有消耗合成玉的确认步骤，而且点它会连「划开包裹」一起跳掉，所以整条抽卡只留这一步。roi 照抄官方 GachaSkip 的右上角 [1144,0,136,148]（模板 55x48），别用全屏免得误匹配。template 显式写（baseTask 不继承模板名）",
        "algorithm": "MatchTemplate",
        "template": "GachaSkip.png",
        "roi": [
            1144,
            0,
            136,
            148
        ],
        "action": "ClickSelf",
        "postDelay": 2000,
        "next": [
            "Tutorial@Gacha@TapToContinue",
            "Tutorial@Main@Loop"
        ]
    },
